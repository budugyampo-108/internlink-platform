# =====================================================================
# InternLink — environment variables (template; contains NO real secrets)
#
# LOCAL DEV:   cp .env.example apps/web/.env   (web + API + Prisma read this)
#              cp .env.example apps/mobile/.env (keep only the EXPO_PUBLIC_* lines)
# VERCEL:      add each variable under Project Settings → Environment Variables
#              and tick Production / Preview / Development as noted below.
# =====================================================================

# ---------- Database (Postgres: Neon, Supabase, Vercel Postgres, etc.) ----------
# Pooled connection string used by the running app (serverless-friendly pooler URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/internlink?sslmode=require"
# Direct (non-pooled) connection used ONLY by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/internlink?sslmode=require"

# ---------- Auth ----------
# >= 32 random chars. Generate: openssl rand -base64 48
# Use a DIFFERENT value for Production vs Preview/Development.
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Public base URL of the deployed web app (used for same-origin checks / redirects).
# Production: https://your-domain.com   Preview: leave unset (VERCEL_URL is used)
APP_URL="http://localhost:3000"

# ---------- Google Maps ----------
# Browser key — shipped to clients BY DESIGN, so restrict it:
#   Google Cloud Console → Credentials → HTTP referrers (web) + enable
#   "Maps JavaScript API" and "Geocoding API" only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Cloud-based map style ID (needed for AdvancedMarker). "DEMO_MAP_ID" works for dev.
NEXT_PUBLIC_GOOGLE_MAP_ID="DEMO_MAP_ID"

# ---------- File storage (Vercel Blob) ----------
# Vercel: Storage → Create Blob store → token is injected automatically.
BLOB_READ_WRITE_TOKEN=""

# ---------- Rate limiting (Upstash Redis; optional in dev, REQUIRED in prod) ----------
# Without these the app falls back to a per-instance in-memory limiter, which is
# NOT effective on serverless (each invocation may be a new instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Mobile app (Expo) — only EXPO_PUBLIC_* are readable in the app ----------
# Local testing on a physical device: use your computer's LAN IP, NOT localhost.
#   EXPO_PUBLIC_API_URL="http://192.168.1.20:3000"
# Deployed:
#   EXPO_PUBLIC_API_URL="https://your-project.vercel.app"
EXPO_PUBLIC_API_URL="http://localhost:3000"
# Native Maps keys (restrict by Android package / iOS bundle ID in Google Cloud).
GOOGLE_MAPS_ANDROID_API_KEY=""
GOOGLE_MAPS_IOS_API_KEY=""
